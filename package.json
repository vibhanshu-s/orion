{
  "name": "orion-local",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --env-file-if-exists=.env --import ./server/preload.mjs --import tsx --watch server/index.ts",
    "client:dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --env-file-if-exists=.env --import ./server/preload.mjs --import tsx --test shared/contracts.test.ts server/safety.test.ts server/artifacts.test.ts server/prompts.test.ts server/decision.test.ts server/research.test.ts server/workflowGraph.test.ts server/providerRetry.test.ts",
    "start": "node --env-file-if-exists=.env --import ./server/preload.mjs --import tsx server/start.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.5",
    "@langchain/classic": "^1.0.50",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/textsplitters": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
