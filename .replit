modules = ["nodejs-22"]
run = "npm run build && npm start"

[env]
HOST = "0.0.0.0"
PORT = "4317"
GEMINI_MODEL = "gemini-3.5-flash-lite"
GEMINI_MIN_INTERVAL_MS = "15000"
RESEARCH_MODE = "documents"

[[ports]]
localPort = 4317
externalPort = 80

[deployment]
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "npm start"]
deploymentTarget = "vm"
