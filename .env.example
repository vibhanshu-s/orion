# Create a Gemini API key through Google AI Studio. The model uses no-cost API
# quotas only when the Google Cloud project is actually on Gemini's Free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PORT=4317

# Optional: named, read-only HTTPS GET APIs. Keep tokens only in this file.
ORION_READ_APIS={}

GEMINI_MIN_INTERVAL_MS=15000

RESEARCH_MODE=documents
